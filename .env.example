# SortSense AI Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=info

# Vision Classifier Backend Settings
# Options: yolov26 | yolov8 | vlm | mock
MODEL_BACKEND=yolov26
MODEL_WEIGHTS_PATH=weights/yolo26n.pt
CONFIDENCE_THRESHOLD=0.50

# Vision LLM (VLM) Settings (Used if MODEL_BACKEND=vlm)
# Options: gemini | openai | ollama
VLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Throttling & Debouncing Settings
# Minimum time between frame inferences per connection (seconds)
FRAME_DEBOUNCE_INTERVAL=0.15

# SortSense Cloud Website API Settings
# Address of the SortSense-Website Cloud API (e.g. deployed on Vercel or local dev)
CLOUD_API_URL=http://localhost:3000
CLOUD_API_TIMEOUT=5.0
CLOUD_API_MAX_RETRIES=3
